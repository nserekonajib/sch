```gitignore
# =========================
# Node.js
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Build output
dist/
build/
.next/
out/
coverage/

# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Flask
instance/
.webassets-cache
flask_session/

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
error_log/

# Uploads and media
uploads/
media/
static/uploads/
temp/

# PDFs and reports
*.pdf

# Secrets and certificates
*.key
*.pem
*.crt
secret.key
private.key

# WhatsApp sessions
whatsapp_auth_files/
.wwebjs_auth/
.wwebjs_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db

# Miscellaneous
.cache/
tmp/
*.tmp

# Docker
.dockerignore

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
```
